  "change": {
    "id": "studio-v0-85-3-ota-hotfix-20260916",
    "userVisible": true,
    "documentationImpact": {
      "status": "required",
      "summary": "Release Sthang Studio 0.85.3 as the emergency Windows signed-OTA activation hotfix that supersedes the 0.85.2 offer after runtime preparation incorrectly required repository-only tests/tsconfig.json. Preserve full source typechecking, runtime shared/server/web validation, rollback/fail-closed behavior, curated Windows and Apple Silicon macOS recovery downloads, and explicit Download & verify then Install & restart. macOS remains manual-download only."
    },
    "releaseImpact": "version"
  },
  "proposal": {
    "displayName": "Sthang Studio",
    "parentBrand": "Sthang",
    "lifecycle": "preview",
    "publicVisibilityRequest": {
      "status": "approved",
      "basis": "Approved public repository; v0.85.3 publication is governed by the repository release gates and externally verified release evidence"
    },
    "source": {
      "visibility": "public",
      "repository": "Sthang-Co-Ltd/Sthang-Studio",
      "normalization": "Public repository visibility and source access are independently verified against the governed repository"
    },
    "distribution": {
      "model": "public-github-release",
      "availability": "available",
      "downloadAuthority": "github-releases",
      "primaryAction": {
        "label": "Download for Windows",
        "href": "https://github.com/Sthang-Co-Ltd/Sthang-Studio/releases/download/v0.85.3/Sthang-Studio-Windows-v0.85.3.zip"
      },
      "sourceAction": {
        "label": "View source on GitHub",
        "href": "https://github.com/Sthang-Co-Ltd/Sthang-Studio"
      }
    },
    "updates": {
      "model": "public-signed-ota",
