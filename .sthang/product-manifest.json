            "macOS Keychain for Apple Silicon installs and source builds",
            "Advanced GEMINI_API_KEY environment or .env fallback"
          ],
          "interactionStore": false,
          "fileApiUpload": true,
          "fileDeleteCalledByApp": false,
          "remoteFileRetention": "provider-controlled-up-to-48-hours",
          "privacyUrl": "https://github.com/Sthang-Co-Ltd/Sthang-Studio/blob/main/PRIVACY.md"
        },
        {
          "id": "sthang-khmer-contribution",
          "purpose": "Optional Khmer caption improvement corpus",
          "availability": "public-default-off-explicit-opt-in",
          "triggers": [
            "explicit Khmer Caption Contributor opt-in",
            "eligible post-consent caption correction followed by approval"
          ],
          "dataSent": [
            "random contributor id",
            "bounded short WAV around corrected caption",
            "generated caption wording",
            "corrected caption wording",
            "caption and clip timing",
            "generated timing, model, and Studio version evidence",
            "audio SHA-256"
          ],
          "staysLocal": [
            "full source video",
            "project title",
            "source filename",
            "local filesystem paths",
            "unrelated captions",
            "topic and context text",
            "correction memory",
            "SRT exports",
            "Gemini API key",
            "product analytics installation id"
          ],
          "credentialOwner": "app-generated-pseudonymous",
          "credentialStorage": "local withdrawal token; service stores only its SHA-256",
          "remoteStorage": [
            "private Cloudflare R2 audio",
            "Cloudflare D1 correction metadata"
          ],
          "retention": "submitted-unverified-180-days; verified-until-withdrawal-or-program-retirement",
          "deletion": "contributor-wide authenticated withdrawal deletes private audio and blanks contributed text",
          "trainingPurpose": true,
          "privacyUrl": "https://github.com/Sthang-Co-Ltd/Sthang-Studio/blob/main/PRIVACY.md"
        },
        {
          "id": "posthog-eu",
          "purpose": "Optional product analytics processed through the Sthang-owned analytics relay",
          "availability": "public-default-off-explicit-opt-in",
          "triggers": [
            "explicit product analytics opt-in"
          ],
          "dataSent": [
            "allow-listed event names",
            "coarse workflow buckets",
            "random analytics installation id",
            "Studio and platform version",
            "ordinary infrastructure and HTTPS metadata may be observed by service providers"
          ],
          "staysLocal": [
            "caption and transcript text",
            "audio and video",
            "filenames and project names",
            "local paths",
            "topic, vocabulary, and context text",
            "correction memory",
            "SRT contents",
            "Gemini API key",
            "Khmer Contributor id"
          ],
          "identity": "random installation id separate from Khmer Contributor identity",
          "personProfiles": false,
          "sessionReplay": false,
          "autocapture": false,
          "privacyUrl": "https://posthog.com/privacy"
        }
      ]
