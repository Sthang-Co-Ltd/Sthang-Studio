    "publicSummary": "Sthang Studio helps Khmer creators turn video and audio into timed captions, review and style them against the real footage, then export UTF-8 SRT or a locally rendered captioned MP4.",
    "publicClaims": [
      "Khmer-first caption editing, review, appearance styling, and local captioned-video export",
      "Reviewed public Beta downloads for Windows and Apple Silicon macOS on GitHub",
      "Timing, editing, projects, history, preview/render work, and exports remain local; Gemini and optional Contributor/analytics transfers are explicitly disclosed"
    ],
    "dataProcessing": {
      "providers": [
        {
          "id": "google-gemini",
          "purpose": "AI caption wording",
          "availability": "current-configured-user-action",
          "triggers": [
            "generate",
            "regenerate"
          ],
          "dataSent": [
            "normalized WAV audio",
            "relevant context",
            "requested wording"
          ],
          "staysLocal": [
            "timing",
            "editing",
            "projects",
            "history",
            "exports"
          ],
          "credentialOwner": "user",
          "keyStorage": [
