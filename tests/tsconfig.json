{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "web-optimizations.test.ts",
    "performance-selection.test.ts",
    "waveform-peaks.test.ts",
    "job-persistence.test.mts",
    "preview-font-cache.test.mts",
    "../scripts/benchmark-performance.mts",
    "deferred-workspace.types.tsx"
  ]
}
