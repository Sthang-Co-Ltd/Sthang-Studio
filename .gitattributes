* text=auto

# Cross-platform source/docs stay LF.
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.css text eol=lf
*.html text eol=lf

# Windows launch/setup scripts remain native CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Approved source brand SVGs are byte-for-byte protected. Do not let
# core.autocrlf or platform checkout rules rewrite their line endings.
apps/web/public/brand/*.svg -text

# Derived brand assets are binary.
*.png binary
*.ico binary
