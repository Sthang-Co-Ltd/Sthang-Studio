# Copy this file to apps/server/.env

# Gemini connection. Recommended for casual users: leave the placeholder and
# configure the key inside Sthang Studio → Settings → AI connection. A valid
# environment key remains supported.
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Dedicated speech recognition is the normal acoustic transcript path.
GEMINI_DEDICATED_TRANSCRIPTION_ENABLED=true
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe

# General Gemini is used for contextual/alternative listens and as a compatibility
# fallback if the dedicated transcription endpoint is unavailable or rejected.
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# A full generation with explicit topic/context may run a second context-aware
# listen after the dedicated acoustic pass. Disable to keep full generation ASR-only.
GEMINI_CONTEXTUAL_REFINEMENT_ENABLED=true

# Transient 408/429/5xx failures are retried automatically; Retry-After is honored.
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BASE_MS=1000
GEMINI_RETRY_MAX_MS=60000
# Applies to the general-model compatibility/context path. Gemini 3.5 Transcribe
# always receives a focused custom vocabulary list when vocabulary is available.
GEMINI_NATIVE_VOCABULARY_BIAS=true

# Local timing = FREE / on-device. No Google Cloud timing API is used.
# KFA is the Khmer-specific primary forced aligner. Gemini Transcribe word
# timestamps are intentionally not used as the primary timing source.
LOCAL_KFA_ENABLED=true

# If KFA cannot align an unusual/mixed-language clip, stay local and use Whisper timing.
LOCAL_WHISPER_FALLBACK_ENABLED=true
LOCAL_WHISPER_MODEL=turbo
LOCAL_WHISPER_DEVICE=auto
LOCAL_WHISPER_COMPUTE_TYPE=auto
LOCAL_WHISPER_LANGUAGE=km
LOCAL_WHISPER_BEAM_SIZE=5
LOCAL_WHISPER_VAD_MIN_SILENCE_MS=400

# Optional override if you do not use the bundled .venv.
# LOCAL_TIMING_PYTHON=C:\Python312\python.exe

# Local app
PORT=8787
WEB_ORIGIN=http://localhost:5188
MAX_UPLOAD_MB=500

# Optional. Defaults assume ffmpeg/ffprobe are available on PATH.
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe

# Selected-range regeneration keeps a little surrounding audio for context.
RANGE_CONTEXT_PADDING_MS=1200
