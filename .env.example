# Copy this file to apps/server/.env

# Gemini = Khmer transcript text authority
# Recommended for casual users: leave the placeholder and configure the key inside
# Sthang Studio → Settings → AI connection. A valid environment key remains supported.
GEMINI_API_KEY=your_google_ai_studio_api_key_here
GEMINI_MODEL=gemini-3.8-flash
# Same Gemini API/key; used when the primary is temporarily unavailable. A 429 advances immediately instead of retrying that model. Empty disables all automatic model failover.
GEMINI_FALLBACK_MODEL=gemini-3.7-flash
# Experimental only. Automatic Gemini Transcribe rescue is disabled by default because Khmer output may contain wrong-script text.
# Set this true only to opt in to one transcription-only pass after both context-aware models are unavailable.
GEMINI_TRANSCRIPTION_RESCUE_ENABLED=false
# The experimental rescue keeps the dedicated Transcribe request shape and can use protected/Accuracy recognition hints, but not the full semantic topic prompt.
GEMINI_TRANSCRIPTION_RESCUE_MODEL=gemini-3.5-transcribe
# Verbatim transcription favors low reasoning overhead for faster response. Supported values: low, medium, high.
GEMINI_TRANSCRIPTION_THINKING_LEVEL=low
# Transient 408/5xx failures may use bounded retry/backoff. HTTP 429 skips same-model Retry-After waits and advances through the configured failover chain.
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BASE_MS=1000
GEMINI_RETRY_MAX_MS=60000
# Bound each Gemini upload/transcription request so one stalled network/model call cannot wedge the local job queue forever.
GEMINI_REQUEST_TIMEOUT_MS=120000
GEMINI_NATIVE_VOCABULARY_BIAS=true

# Local timing = FREE / on-device. No Google Cloud timing API is used.
LOCAL_KFA_ENABLED=true
LOCAL_WHISPER_FALLBACK_ENABLED=true
LOCAL_WHISPER_MODEL=turbo
LOCAL_WHISPER_DEVICE=auto
LOCAL_WHISPER_COMPUTE_TYPE=auto
LOCAL_WHISPER_LANGUAGE=km
LOCAL_WHISPER_BEAM_SIZE=5
LOCAL_WHISPER_VAD_MIN_SILENCE_MS=400
# LOCAL_TIMING_PYTHON=C:\Python312\python.exe

# Local app
PORT=8787
WEB_ORIGIN=http://localhost:5188
MAX_UPLOAD_MB=500
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
RANGE_CONTEXT_PADDING_MS=1200

# Optional operator/development overrides for v0.8 Sthang cloud features.
# Ordinary releases use the versioned public values in config/product-services.json,
# and both features still require the user's explicit in-app privacy choice.
STHANG_CONTRIBUTION_ENDPOINT=
STHANG_ANALYTICS_ENDPOINT=
