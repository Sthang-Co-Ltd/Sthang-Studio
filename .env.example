# Copy this file to apps/server/.env

# Gemini = Khmer transcript text authority
# Recommended for casual users: leave the placeholder and configure the key inside
# Sthang Studio → Settings → AI connection. A valid environment key remains supported.
GEMINI_API_KEY=your_google_ai_studio_api_key_here
GEMINI_MODEL=gemini-3.7-flash
# Same Gemini API/key; used only if the primary stays overloaded after retries. Empty disables fallback.
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# Verbatim transcription favors low reasoning overhead for faster response. Supported values: low, medium, high.
GEMINI_TRANSCRIPTION_THINKING_LEVEL=low
# Transient 408/429/5xx failures are retried automatically; Retry-After is honored.
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BASE_MS=1000
GEMINI_RETRY_MAX_MS=60000
GEMINI_NATIVE_VOCABULARY_BIAS=true

# Local timing = FREE / on-device. No Google Cloud timing API is used.
LOCAL_KFA_ENABLED=true
LOCAL_WHISPER_FALLBACK_ENABLED=true
LOCAL_WHISPER_MODEL=turbo
LOCAL_WHISPER_DEVICE=auto
LOCAL_WHISPER_COMPUTE_TYPE=auto
LOCAL_WHISPER_LANGUAGE=km
LOCAL_WHISPER_BEAM_SIZE=5
LOCAL_WHISPER_VAD_MIN_SILENCE_MS=400
# LOCAL_TIMING_PYTHON=C:\Python312\python.exe

# Local app
PORT=8787
WEB_ORIGIN=http://localhost:5188
MAX_UPLOAD_MB=500
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
RANGE_CONTEXT_PADDING_MS=1200

# Optional v0.8 cloud features. Both also require explicit in-app user consent.
# Leave the contribution endpoint empty unless the separately governed Sthang service is deployed.
STHANG_CONTRIBUTION_ENDPOINT=
# PostHog project key is a project ingestion key, not a personal API key. Empty keeps analytics fully off.
STHANG_POSTHOG_PROJECT_KEY=
# Studio uses the EU ingestion host by default when analytics is configured.
STHANG_POSTHOG_HOST=https://eu.i.posthog.com
