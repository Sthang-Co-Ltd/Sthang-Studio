{
  "name": "sthang-studio",
  "private": true,
  "version": "0.7.14",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sthang-Co-Ltd/Sthang-Studio.git"
  },
  "homepage": "https://sthang.app/",
  "bugs": {
    "url": "https://github.com/Sthang-Co-Ltd/Sthang-Studio/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/verify-brand-assets.mjs && node scripts/build.mjs",
    "typecheck": "node scripts/verify-brand-assets.mjs && node scripts/typecheck.mjs",
    "start": "node apps/server/dist/index.js",
    "verify:brand": "node scripts/verify-brand-assets.mjs",
    "verify:manifest": "node scripts/verify-product-manifest.mjs",
    "check:public": "node scripts/verify-product-manifest.mjs && node scripts/public-readiness-check.mjs",
    "test:public": "node --test tests/public-readiness.test.mjs",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows-release.ps1",
    "ci": "npm run test:public && npm run check:public && npm run typecheck && npm run build"
  },
  "allowScripts": {
    "@google/genai": true,
    "esbuild": true,
    "protobufjs": true
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
