{
  "name": "sthang-studio-ota-signer",
  "main": "src/index.mjs",
  "compatibility_date": "2026-08-31",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "signer.sthang.app",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "STUDIO_UPDATES",
      "bucket_name": "sthang-studio-updates"
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "STUDIO_SIGNING_KEY",
      "store_id": "__STHANG_STUDIO_SECRETS_STORE_ID__",
      "secret_name": "STHANG_STUDIO_OTA_PRIVATE_KEY_V1"
    }
  ]
}
